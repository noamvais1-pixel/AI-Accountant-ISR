# ---------------------------------------------------------------------------
# מסד נתונים
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER@localhost:5433/roeh_heshbon"

# ---------------------------------------------------------------------------
# Gemini — חילוץ נתונים מצילומי קבלות
# מפתח מ-https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# ---------------------------------------------------------------------------
# קארדקום — משיכת חשבוניות והפקת חשבוניות
# הפרטים נמצאים במשרד הנהלת החשבונות של קארדקום תחת "פרטי API"
# ---------------------------------------------------------------------------
CARDCOM_TERMINAL_NUMBER=""
CARDCOM_API_NAME=""
CARDCOM_API_PASSWORD=""
CARDCOM_BASE_URL="https://secure.cardcom.solutions"
# מצב בטוח: הפקת חשבוניות נחסמת עד שמשנים ל-false. חשבונית שהופקה היא מסמך חוקי שאי אפשר למחוק.
CARDCOM_DRY_RUN="true"
# האם מחירי השורות במסוף מפורשים ככוללים מע"מ (ברירת מחדל: true, כפי שמופיע בדוח המסמכים של המסוף)
CARDCOM_PRICES_INCLUDE_VAT=true

# ---------------------------------------------------------------------------
# אחסון קבצים סרוקים
# ---------------------------------------------------------------------------
UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------------------
# גוגל דרייב — גיבוי הצילומים
# יצירת אישורים: console.cloud.google.com → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3737/api/drive/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DRIVE_FOLDER_NAME="רואה חשבון AI"
APP_URL="http://localhost:3737"

# ---------------------------------------------------------------------------
# אפליקציית המק (scripts/desktop) — אופציונלי.
# אם מוגדר, האפליקציה תפעיל את Postgres בעצמה כשהוא כבוי.
# ---------------------------------------------------------------------------
LOCAL_PG_BIN=""
LOCAL_PGDATA=""

# ---------------------------------------------------------------------------
# פריסה לענן — Supabase (מסד נתונים, אחסון קבצים והתחברות)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# מפתח שירות — צד שרת בלבד. עוקף הרשאות, אסור שיגיע לדפדפן.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"
# רשימת הכתובות שמורשות להיכנס, מופרדות בפסיק. רשימה ריקה חוסמת הכל.
ALLOWED_EMAILS=""
# חיבור ישיר למסד (בלי מאגר חיבורים) — נדרש רק לשינויי סכימה
DIRECT_URL=""
# מאפשר גם קליטה מתיקייה קיימת בדרייב (דורש הרשאת קריאה רחבה יותר)
DRIVE_IMPORT_ENABLED="false"
